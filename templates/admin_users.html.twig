{% extends 'admin_layout.html.twig' %}

{% block title %}
    Userlist - MIU
{% endblock %}

{% block managecontent %}
<div class="mb-3 text-end">
    <a href="{{ path('admin_create_user') }}" class="btn btn-primary btn-sm"><i class="fas fa-user-plus"></i> Create user</a>
</div>
<table class="table-responsive-sm table table-dark table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Storage usage</th>
            <th>Status</th>
            <th>Role</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for user in userlist %}
        <tr data-userid="{{ user.id }}">
            <td>{{ user.id }}</td>
            <td>{{ user.login }}</td>
            <td>{{ user.email }}</td>
            <td data-usersize>Calculating...</td>
            <td data-userstatus>
                {% if user.active %}
                    <span class="badge bg-success">Active</span>
                {% else %}
                    <span class="badge bg-secondary">Disabled</span>
                {% endif %}
            </td>
            <td>{{ user.role }}</td>
            <td>
                {% if user.id and user.id != app.user.id %}
                    <div class="btn-group btn-group-sm" role="group" aria-label="User actions">
                        <button type="button" class="btn {{ user.active ? 'btn-warning' : 'btn-success' }}"
                                data-toggle-user="{{ user.id }}" data-active="{{ user.active ? 1 : 0 }}">
                            {{ user.active ? 'Disable' : 'Enable' }}
                        </button>
                        <button type="button" class="btn btn-danger" data-reset-password="{{ user.id }}">
                            Reset password
                        </button>
                    </div>
                    <div data-password-result class="mt-1 small text-nowrap" hidden></div>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}