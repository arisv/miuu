{% extends 'manage_layout.html.twig' %}

{% block managecontent %}
    <div class="p-3">
        <h3 class="mb-3">Remote Upload</h3>
        <label for="uploadResult" class="form-label">Your API token for ShareX and other remote uploaders</label>
        <div class="input-group mb-4" style="max-width: 32rem">
            <input class="form-control" id="uploadResult" readonly title="Your token for ShareX" value="{{ app.user.remoteToken }}">
            <button id="clipboardbtn" type="button" class="btn btn-success clipbutton" data-clipboard-target="#uploadResult" title="Copy to clipboard">
                <i class="fa-regular fa-copy" aria-hidden="true"></i><span class="visually-hidden">Copy to clipboard</span>
            </button>
            <button type="button" class="btn btn-warning" data-refresh-token data-refresh-url="{{ path('user_regenerate_token') }}" title="Generate a new token">
                <i class="fa-solid fa-rotate" aria-hidden="true"></i><span class="visually-hidden">Generate a new token</span>
            </button>
        </div>
        <div data-refresh-token-result class="small mb-4" hidden></div>

        <div class="admin-list-head d-flex align-items-center justify-content-between mb-2 mt-4">
            <h4 class="mb-0"><i class="fa-solid fa-mobile-screen me-2" aria-hidden="true"></i>Signed-in devices <span class="admin-chip ms-2">{{ devices|length }}</span></h4>
        </div>
        <p class="api-help small mb-3">Devices are added by logging in from the MIU app. Revoking a device signs it out immediately.</p>
        {% if devices is empty %}
            <p class="admin-sub small mb-4" data-devices-empty>No devices signed in.</p>
        {% else %}
        <ul class="admin-list admin-list-devices mb-4" data-devices-list>
        {% for device in devices %}
            {% set icon = device.platform == 'ios' or device.platform == 'macos' ? 'fa-brands fa-apple' : (device.platform == 'android' ? 'fa-brands fa-android' : 'fa-solid fa-mobile-screen') %}
            <li class="admin-row" data-deviceid="{{ device.id }}">
                <div class="admin-avatar is-anon" aria-hidden="true"><i class="{{ icon }}"></i></div>
                <div class="admin-identity">
                    <div class="admin-title">{{ device.name }} <span class="admin-chip admin-id">{{ device.tokenPrefix }}&hellip;</span></div>
                    <div class="admin-sub">{{ device.platform|capitalize }}</div>
                </div>
                <div class="admin-meta">
                    <div class="admin-stat" data-stat="created">
                        <span class="admin-stat-label">Signed in</span>
                        <span class="admin-stat-value">{{ device.createdAt|date('Y-m-d H:i') }}</span>
                    </div>
                    <div class="admin-stat" data-stat="used">
                        <span class="admin-stat-label">Last used</span>
                        <span class="admin-stat-value">{{ device.lastUsedAt ? device.lastUsedAt|date('Y-m-d H:i') : 'never' }}</span>
                    </div>
                </div>
                <div class="admin-actions">
                    <button type="button" class="btn btn-danger btn-sm" data-revoke-device="{{ device.id }}" data-revoke-url="{{ path('user_revoke_device') }}">
                        <i class="fa-solid fa-right-from-bracket me-1" aria-hidden="true"></i>Revoke
                    </button>
                </div>
            </li>
        {% endfor %}
        </ul>
        {% endif %}

        {% set uploadUrl = url('set_file_form') %}
        {% set base = url('home')|trim('/') %}
        <section class="api-doc mt-4">
            <div class="d-flex align-items-baseline justify-content-between flex-wrap gap-2 mb-3">
                <h4 class="mb-0">API reference</h4>
                <span class="api-base">Base URL <code>{{ base }}</code></span>
            </div>

            <details class="api-endpoint">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/getfile/</code>
                    <span class="api-summary">Upload a file</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Authenticates with your token. The body is <code>multipart/form-data</code>.</p>
                    <h6 class="api-h">Form fields</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>meowfile_remote</code></td><td>file</td><td><span class="api-req">required</span></td><td>The file to store.</td></tr>
                            <tr><td><code>private_key</code></td><td>string</td><td><span class="api-req">required</span></td><td>Your API token from this page.</td></tr>
                            <tr><td><code>api_ver</code></td><td>string</td><td><span class="api-opt">optional</span></td><td><code>v1</code> (default): <code>file</code> is always the direct link. <code>v2</code>: images, video and audio keep the direct link, while text, archives, binaries and other files get the <code>/v/</code> file page instead.</td></tr>
                            <tr><td><code>plaintext</code></td><td>any</td><td><span class="api-opt">optional</span></td><td>When present, the reply is the <code>file</code> URL as <code>text/plain</code> with status <code>201</code>.</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <h6 class="api-h">Responses</h6>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{
  "file":    "{{ base }}/a1b2c3d4e5.png",
  "direct":  "{{ base }}/a1b2c3d4e5.png",
  "manage":  "{{ base }}/v/a1b2c3d4e5.png",
  "delete":  "{{ base }}/d/a1b2c3d4e5.png?key=…",
  "api_ver": "v1"
}</code></pre>
                        <dl class="api-fields">
                            <dt><code>file</code></dt><dd>The link to hand out: the direct link, or with <code>api_ver=v2</code> the file page for non-media files.</dd>
                            <dt><code>direct</code></dt><dd>Always the direct link to the stored file.</dd>
                            <dt><code>manage</code></dt><dd>HTML page with preview, copy link and, when signed in as the owner, delete.</dd>
                            <dt><code>delete</code></dt><dd>Signed link that marks the file for deletion. It needs no login, so treat it as a secret.</dd>
                        </dl>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">201</span> <code>text/plain</code> <span class="api-dim">with <code>plaintext</code></span></div>
<pre class="api-pre"><code>{{ base }}/a1b2c3d4e5.png</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">400</span> <code>application/json</code> <span class="api-dim">invalid token, disabled account or unusable file</span></div>
<pre class="api-pre"><code>{ "error": "Upload rejected: invalid token or unusable file" }</code></pre>
                    </div>
                    <h6 class="api-h">Example</h6>
<pre class="api-pre"><code>curl -F "meowfile_remote=@screenshot.png" \
     -F "private_key={{ app.user.remoteToken }}" \
     -F "api_ver=v2" \
     {{ uploadUrl }}</code></pre>
                </div>
            </details>

            <details class="api-endpoint">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/d/{id}.{ext}</code>
                    <span class="api-summary">Mark a file for deletion</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Use the <code>delete</code> link from the upload response. No token or login is needed; the <code>key</code> proves ownership of the link.</p>
                    <h6 class="api-h">Parameters</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>key</code></td><td>form or query</td><td><span class="api-req">required</span></td><td>Signature issued with the upload response.</td></tr>
                            <tr><td><code>Accept: application/json</code></td><td>header</td><td><span class="api-opt">optional</span></td><td>Answer as JSON instead of an HTML page. <code>?format=json</code> works too.</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <h6 class="api-h">Responses</h6>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "status": "ok", "deleted": true }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">403</span> <code>application/json</code> <span class="api-dim">unknown file or invalid key</span></div>
<pre class="api-pre"><code>{ "status": "error", "message": "Unknown file or invalid key" }</code></pre>
                    </div>
                    <p class="api-dim mb-0"><span class="api-method api-method-get">GET</span> on the same link opens a confirmation page, which is what ShareX-style clients do with a deletion URL.</p>
                </div>
            </details>

            <details class="api-endpoint">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/v/{id}.{ext}</code>
                    <span class="api-summary">File page</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead mb-0">HTML preview of the file with download and copy link. Owners and admins also get delete. Returns <code>404</code> once a file is marked for deletion, except for its owner.</p>
                </div>
            </details>

            <details class="api-endpoint">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">App</span>
                    <span class="api-summary">Install MIU and share to it</span>
                </summary>
                <div class="api-endpoint-body">
                    <div class="table-responsive">
                    <table class="api-table">
                        <tbody>
                            <tr><th>Android</th><td>Open MIU in Chrome, log in, then <em>Install app</em> from the browser menu. The installed app appears in the system share sheet: shared photos, videos and files upload to your account, shared links are mirrored, and you land on the file page with its copy button.</td></tr>
                            <tr><th>iPhone / iPad</th><td>Safari does not support share targets. Add MIU to the home screen for the app feel, and use a Shortcut for sharing: <em>Receive</em> images/files from the share sheet, then <em>Get Contents of URL</em> to <code>{{ uploadUrl }}</code> as <code>POST</code>, form body with <code>meowfile_remote</code> = the shortcut input, <code>private_key</code> = your token, <code>api_ver</code> = <code>v2</code>, <code>plaintext</code> = <code>1</code>. Finish with <em>Copy to Clipboard</em> on the result.</td></tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </details>

            <details class="api-endpoint">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">ShareX</span>
                    <span class="api-summary">Custom uploader settings</span>
                </summary>
                <div class="api-endpoint-body">
                    <div class="table-responsive">
                    <table class="api-table">
                        <tbody>
                            <tr><th>Destination type</th><td>Image uploader, File uploader</td></tr>
                            <tr><th>Method</th><td><code>POST</code></td></tr>
                            <tr><th>Request URL</th><td><code>{{ uploadUrl }}</code></td></tr>
                            <tr><th>Body</th><td>Form data (multipart/form-data)</td></tr>
                            <tr><th>File form name</th><td><code>meowfile_remote</code></td></tr>
                            <tr><th>Arguments</th><td><code>private_key</code> = your token, <code>api_ver</code> = <code>v2</code></td></tr>
                            <tr><th>URL</th><td><code>{json:file}</code></td></tr>
                            <tr><th>Deletion URL</th><td><code>{json:delete}</code></td></tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </details>
            <h5 class="api-group mt-4 mb-2">App API</h5>
            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/auth/login</code>
                    <span class="api-summary">App API: sign in a device</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Public. Issues a per-device Bearer token; the device appears in the list above and can be revoked there. JSON or form body.</p>
                    <h6 class="api-h">Body</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>login</code></td><td>body</td><td><span class="api-req">required</span></td><td>Username or email.</td></tr>
                            <tr><td><code>password</code></td><td>body</td><td><span class="api-req">required</span></td><td></td></tr>
                            <tr><td><code>device_name</code></td><td>body</td><td><span class="api-req">required</span></td><td>Shown in the device list, up to 100 characters.</td></tr>
                            <tr><td><code>platform</code></td><td>body</td><td><span class="api-opt">optional</span></td><td><code>ios</code>, <code>android</code>, <code>macos</code> or <code>other</code> (default).</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <h6 class="api-h">Responses</h6>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">201</span> <code>application/json</code></div>
<pre class="api-pre"><code>{
  "token": "…", "token_type": "Bearer",
  "device": { "id": 1, "name": "My phone", "platform": "ios", "token_prefix": "b81a480b", "created_at": "…", "last_used_at": null, "current": true },
  "user": { "id": 3, "login": "alice", "email": "…", "role": "user", "active": true }
}</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">401</span> <code>application/json</code> <span class="api-dim">wrong login or password</span></div>
<pre class="api-pre"><code>{ "error": { "code": "invalid_credentials", "message": "Invalid login or password." } }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">403</span> <code>application/json</code> <span class="api-dim">disabled account &middot; <code>account_disabled</code></span></div>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">422</span> <code>application/json</code> <span class="api-dim">missing fields &middot; <code>validation_failed</code> with <code>details</code></span></div>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">429</span> <code>application/json</code> <span class="api-dim">more than 10 attempts in 15 minutes &middot; <code>too_many_requests</code></span></div>
                    </div>
                    <h6 class="api-h">Example</h6>
<pre class="api-pre"><code>curl -X POST {{ base }}/api/v1/auth/login -H "Content-Type: application/json" \
     -d '{"login":"you","password":"…","device_name":"My phone","platform":"ios"}'</code></pre>
                    <p class="api-dim mb-0">Every other <code>/api/v1/</code> call answers errors as <code>{"error": {"code", "message", "details"?}}</code>; a revoked token gets <code>401 unauthenticated</code>.</p>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/auth/logout</code>
                    <span class="api-summary">Revoke the calling device</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">204</span> <code></code> <span class="api-dim">the device token stops working immediately</span></div>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/api/v1/server</code>
                    <span class="api-summary">Server capabilities</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Public. Lets a client validate a server URL before signing in.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{
  "name": "MIU",
  "api_version": 1,
  "allow_registration": true,
  "allow_anonymous_uploads": true,
  "max_upload_bytes": 104857600,
  "max_remote_file_bytes": 104857600,
  "page_sizes": [24, 48, 72, 96],
  "thumbnail_width": 350,
  "delete_grace_minutes": 1
}</code></pre>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/api/v1/files</code>
                    <span class="api-summary">List your uploads (paged)</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <h6 class="api-h">Query parameters</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>page-size</code></td><td>query</td><td><span class="api-opt">optional</span></td><td>24 (default), 48, 72 or 96.</td></tr>
                            <tr><td><code>order-date</code></td><td>query</td><td><span class="api-opt">optional</span></td><td><code>new</code> or <code>old</code>.</td></tr>
                            <tr><td><code>order-size</code></td><td>query</td><td><span class="api-opt">optional</span></td><td><code>big</code> or <code>small</code>.</td></tr>
                            <tr><td><code>calendar-start</code>, <code>calendar-end</code></td><td>query</td><td><span class="api-opt">optional</span></td><td>Month range as <code>Y-m-d</code>, same as the calendar on the pictures page.</td></tr>
                            <tr><td><code>cursor</code></td><td>query</td><td><span class="api-opt">optional</span></td><td>Opaque value from <code>next_cursor</code>; resend the same order and filter parameters with it.</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{
  "files": [ { …file object… } ],
  "has_next_page": true,
  "next_cursor": "…",
  "page_size": 24
}</code></pre>
                    </div>
                    <h6 class="api-h">File object</h6>
<pre class="api-pre"><code>{
  "id": 4711, "slug": "a1b2c3d4e5", "name": "IMG_0001.jpg", "extension": "jpeg", "mime": "image/jpeg",
  "size": 1048576, "size_formatted": "1 MB", "uploaded_at": "2026-09-19T10:11:12+00:00",
  "kind": "image",                 // image | video | audio | text | file
  "thumbnailable": true, "embeddable": true, "deleted": false, "deleted_at": null, "icon": "fa-file-image",
  "urls": {
    "direct":    "{{ base }}/a1b2c3d4e5.jpeg",
    "view":      "{{ base }}/v/a1b2c3d4e5.jpeg",
    "share":     "{{ base }}/a1b2c3d4e5.jpeg",      // direct for media, view page otherwise (api_ver=v2 rule)
    "thumbnail": "{{ base }}/thumb/a1b2c3d4e5.jpeg", // null when not thumbnailable or deleted; 404 until generated
    "delete":    "{{ base }}/d/a1b2c3d4e5.jpeg?key=…" // only on single-file responses
  }
}</code></pre>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/api/v1/files/dates</code>
                    <span class="api-summary">Month buckets of your uploads</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code> <span class="api-dim">newest first</span></div>
<pre class="api-pre"><code>{
  "months": [
    { "year": 2026, "month": 9, "count": 12 },
    { "year": 2026, "month": 8, "count": 4 }
  ]
}</code></pre>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/api/v1/files/{id}</code>
                    <span class="api-summary">File details</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "file": { …file object with urls.delete… } }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">404</span> <code>application/json</code> <span class="api-dim">unknown id or not your file &middot; <code>not_found</code></span></div>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/files</code>
                    <span class="api-summary">Upload a file</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <h6 class="api-h">Form fields</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>file</code></td><td>file</td><td><span class="api-req">required</span></td><td>The file to store (<code>multipart/form-data</code>).</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">201</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "file": { …file object… } }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">400</span> <code>application/json</code> <span class="api-dim">no file part &middot; <code>no_file</code></span></div>
                    </div>
                    <h6 class="api-h">Example</h6>
<pre class="api-pre"><code>curl -X POST {{ base }}/api/v1/files -H "Authorization: Bearer &lt;token&gt;" -F file=@shot.png</code></pre>
                    <p class="api-dim mb-0">A device token is also accepted as <code>private_key</code> on <code>/getfile/</code>, which share extensions use.</p>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/files/mirror</code>
                    <span class="api-summary">Mirror a remote URL</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <h6 class="api-h">Body</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>url</code></td><td>body</td><td><span class="api-req">required</span></td><td>Direct <code>http(s)</code> link to fetch.</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">201</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "file": { …file object… } }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">422</span> <code>application/json</code> <span class="api-dim">unreachable, too large or not a file &middot; <code>mirror_failed</code></span></div>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-delete">DELETE</span>
                    <code class="api-path">/api/v1/files/{id}</code>
                    <span class="api-summary">Mark a file for deletion</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <p class="api-lead">The file stops being served at once and is purged after the grace period; until then it can be restored.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "file": { …, "deleted": true, "deleted_at": "…", "urls": { …, "thumbnail": null } } }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">404</span> <code>application/json</code> <span class="api-dim">unknown id or not your file</span></div>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/files/{id}/restore</code>
                    <span class="api-summary">Undo a deletion</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "file": { …, "deleted": false } }</code></pre>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/api/v1/me</code>
                    <span class="api-summary">Your account</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{
  "user": { "id": 3, "login": "alice", "email": "alice@example.org", "role": "user", "active": true }
}</code></pre>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/me/email</code>
                    <span class="api-summary">Change email</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <h6 class="api-h">Body</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>email</code></td><td>body</td><td><span class="api-req">required</span></td><td>Must be free as both an email and a username.</td></tr>
                            <tr><td><code>current_password</code></td><td>body</td><td><span class="api-req">required</span></td><td></td></tr>
                        </tbody>
                    </table>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "user": { … } }</code></pre>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">422</span> <code>application/json</code> <span class="api-dim"><code>validation_failed</code> with <code>details.email</code> or <code>details.current_password</code></span></div>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-post">POST</span>
                    <code class="api-path">/api/v1/me/password</code>
                    <span class="api-summary">Change password</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <h6 class="api-h">Body</h6>
                    <div class="table-responsive">
                    <table class="api-table">
                        <thead><tr><th>Name</th><th>In</th><th>Required</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>current_password</code></td><td>body</td><td><span class="api-req">required</span></td><td></td></tr>
                            <tr><td><code>new_password</code></td><td>body</td><td><span class="api-req">required</span></td><td>At least 6 characters.</td></tr>
                            <tr><td><code>revoke_other_devices</code></td><td>body</td><td><span class="api-opt">optional</span></td><td><code>true</code> signs out every other device.</td></tr>
                        </tbody>
                    </table>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{ "user": { … }, "revoked_devices": 0 }</code></pre>
                    </div>
                    <p class="api-dim mb-0">Web sessions remembered with a cookie are signed out by a password change as well.</p>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-get">GET</span>
                    <code class="api-path">/api/v1/devices</code>
                    <span class="api-summary">Signed-in devices</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">200</span> <code>application/json</code></div>
<pre class="api-pre"><code>{
  "devices": [
    {
      "id": 1,
      "name": "My phone",
      "platform": "ios",
      "token_prefix": "b81a480b",
      "created_at": "2026-09-19T10:11:12+00:00",
      "last_used_at": "2026-09-19T10:15:00+00:00",
      "current": true
    }
  ]
}</code></pre>
                    </div>
                </div>
            </details>

            <details class="api-endpoint api-endpoint-app">
                <summary class="api-endpoint-head">
                    <span class="api-method api-method-delete">DELETE</span>
                    <code class="api-path">/api/v1/devices/{id}</code>
                    <span class="api-summary">Revoke a device</span>
                </summary>
                <div class="api-endpoint-body">
                    <p class="api-lead">Requires <code>Authorization: Bearer &lt;device token&gt;</code>.</p>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-ok">204</span> <code></code></div>
                    </div>
                    <div class="api-response">
                        <div class="api-status"><span class="api-code-err">404</span> <code>application/json</code> <span class="api-dim">unknown id or not your device</span></div>
                    </div>
                </div>
            </details>

        </section>
    </div>
{% endblock %}
