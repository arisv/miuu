{% set previewKind = item.markedForDeletion ? 'hidden' : (item.isMimeType(['image']) ? 'image' : (item.isMimeType(['video']) ? 'video' : (item.isMimeType(['audio']) ? 'audio' : (item.isTextual ? 'text' : 'file')))) %}
{% set groupLabel = file_group_label(item, group|default('none')) %}
<div class="col"{% if groupLabel is not null %} data-group="{{ groupLabel }}"{% endif %}>
    <div class="itembox" tabindex="0"
        data-preview-kind="{{ previewKind }}"
        data-preview-url="{{ path('get_file_custom_url', {'customUrl': item.customUrl, 'fileExtension': item.originalExtension}) }}"
        data-preview-name="{{ item.originalName }}"
        data-preview-date="{{ item.getDate|date("Y-m-d H:i:s") }}"
        data-preview-view="{{ path('view_file', {'customUrl': item.customUrl, 'fileExtension': item.originalExtension}) }}"
        {% if not item.markedForDeletion and item.isThumbnailable %}data-preview-thumb="{{ path('serve_file_thumbnail', {'customUrl': item.customUrl, 'fileExtension': item.originalExtension}) }}"{% endif %}
        data-preview-icon="{{ item.markedForDeletion ? 'fa-trash' : file_icon(item.internalMimetype, item.originalExtension, item.originalName) }}"
        {% if not item.markedForDeletion and item.isThumbnailable %}
        style="background-image: url({{ path('serve_file_thumbnail', {'customUrl': item.customUrl, 'fileExtension': item.originalExtension}) }})"
        {% endif %}
        >
        {% if item.markedForDeletion %}
            <div class="itembox-icon is-hidden-file" aria-hidden="true"><i class="fa-solid fa-trash"></i><span class="itembox-ext">deleted</span></div>
        {% elseif not item.isThumbnailable %}
            {% set shownExt = '.' in item.originalName ? item.originalName|split('.')|last : item.originalExtension %}
            <div class="itembox-icon" aria-hidden="true"><i class="fa-solid {{ file_icon(item.internalMimetype, item.originalExtension, item.originalName) }}"></i><span class="itembox-ext">{{ (shownExt ?: 'bin')|slice(0, 7) }}</span></div>
        {% endif %}
        <label class="itembox-select">
            <input type="checkbox" class="itembox-check" data-fileid="{{ item.id }}" aria-label="Select {{ item.originalName }}">
            <span class="itembox-check-mark"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
        </label>
        <div class="itembox-text" >
                <p>{{ item.originalName }}</p>
                <p>{{ item.getDate|date("Y-m-d H:i:s") }}</p>
        </div>
        <div class="itembox-hover">
            <div class="itembox-controls">
                <button type="button" class="btn btn-secondary" data-preview title="Preview"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
                <a href="{{ path('get_file_custom_url', {'customUrl': item.customUrl, 'fileExtension': item.originalExtension}) }}" class="btn btn-primary"><i class="fa-solid fa-download" aria-hidden="true"></i></a>
                <button data-deleteaction="del" data-deleteid="{{ item.id }}" data-bs-toggle="tooltip" title="Delete" class="btn btn-danger" {% if item.markedForDeletion == true %}style="display:none"{% endif %}><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                <button data-deleteaction="undo" data-deleteid="{{ item.id }}" data-bs-toggle="tooltip" title="Undelete" class="btn btn-warning"  {% if item.markedForDeletion == false %}style="display:none"{% endif %}><i class="fa-solid fa-trash-arrow-up" aria-hidden="true"></i></button>
            </div>
        </div>
    </div>
</div>