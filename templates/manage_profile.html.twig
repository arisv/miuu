{% extends 'manage_layout.html.twig' %}

{% form_theme form 'form/miu_errors.html.twig' %}
{% form_theme emailForm 'form/miu_errors.html.twig' %}

{% block managecontent %}
    <div class="p-3">
        <div id="profile" class="mb-4">
            <h3>Welcome, {{ app.user.login }}</h3>
            <p class="mb-0">
                Email: <strong>{{ app.user.email }}</strong>
            </p>
            <p class="mb-0">
                Current API token: <strong>{{ app.user.remotetoken }}</strong>
            </p>
        </div>

        <div class="row mb-3 g-4">
            <div class="col-md-5 col-lg-4">
            {{ form_start(emailForm) }}

            <h4 class="mb-3">Change email</h4>

            <div class="mb-3 l-sign-mb-3">
                {{ form_label(emailForm.email, "New email", {'label_attr': {'class':'visually-hidden'} }) }}
                {{ form_widget(emailForm.email, {'attr':{'class': 'form-control', 'placeholder': 'New email', 'autocomplete': 'email'}}) }}
                {{ form_errors(emailForm.email) }}
            </div>

            <div class="mb-3 l-sign-mb-3">
                {{ form_label(emailForm.currentPassword, "Current password", {'label_attr': {'class':'visually-hidden'} }) }}
                {{ form_widget(emailForm.currentPassword, {'attr':{'class': 'form-control', 'placeholder': 'Current password', 'autocomplete': 'current-password'}}) }}
                {{ form_errors(emailForm.currentPassword) }}
            </div>

            <div class="l-sign-inner">
                {{ form_errors(emailForm) }}
                <div class="l-sign-btn">
                    <button type="submit" class="btn btn-primary btn-wmid"><i class="fa-solid fa-envelope fa-fw me-2" aria-hidden="true"></i>Change email</button>
                </div>
            </div>

            {{ form_end(emailForm) }}
            </div>
            <div class="col-md-5 col-lg-4">
            {{ form_start(form) }}

            <h4 class="mb-3">Change password</h4>

            <div class="mb-3 l-sign-mb-3">
                {{ form_label(form.currentPassword, "Current password", {'label_attr': {'class':'visually-hidden'} }) }}
                {{ form_widget(form.currentPassword, {'attr':{'class': 'form-control', 'placeholder': 'Current password'}}) }}
                {{ form_errors(form.currentPassword) }}
            </div>

            <div class="mb-3 l-sign-mb-3">
                {{ form_label(form.newPassword.first, "New password", {'label_attr': {'class':'visually-hidden'} }) }}
                {{ form_widget(form.newPassword.first, {'attr':{'class': 'form-control', 'placeholder': 'New password'}}) }}
                {{ form_errors(form.newPassword.first) }}
            </div>

            <div class="mb-3 l-sign-mb-3">
                {{ form_label(form.newPassword.second, "Repeat new password", {'label_attr': {'class':'visually-hidden'} }) }}
                {{ form_widget(form.newPassword.second, {'attr':{'class': 'form-control', 'placeholder': 'Repeat new password'}}) }}
                {{ form_errors(form.newPassword.second) }}
            </div>

            <div class="l-sign-inner">
                {{ form_errors(form) }}
                <div class="l-sign-btn">
                    <button type="submit" class="btn btn-primary btn-wmid"><i class="fa-solid fa-key fa-fw me-2" aria-hidden="true"></i>Change password</button>
                </div>
            </div>

            {{ form_end(form) }}
            </div>
            <div class="col-md-5 col-lg-4">
                <h4 class="mb-3">Delete all files</h4>
                {% if purge.total == 0 %}
                    <p class="text-secondary">You have no files.</p>
                {% elseif purge.pending %}
                    <p>All <strong>{{ purge.total }}</strong> of your files are queued for deletion and will be removed for good shortly. Until then you can bring them all back.</p>
                    <form method="post" action="{{ path('cabinet_purge_cancel') }}" class="purge-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('purge_files') }}">
                        <div class="l-sign-btn">
                            <button type="submit" class="btn btn-warning btn-wmid"><i class="fa-solid fa-trash-arrow-up fa-fw me-2" aria-hidden="true"></i>Cancel deletion</button>
                        </div>
                    </form>
                {% else %}
                    <p>Queues every one of your <strong>{{ purge.active }}</strong> files for deletion{% if purge.marked %} ({{ purge.marked }} already in the trash){% endif %}. Links stop working immediately; the files are removed for good after a short grace period, during which you can cancel here.</p>
                    <form method="post" action="{{ path('cabinet_purge') }}" class="purge-form" autocomplete="off">
                        <input type="hidden" name="_token" value="{{ csrf_token('purge_files') }}">
                        <div class="mb-3 l-sign-mb-3">
                            <label class="visually-hidden" for="purgePassword">Current password</label>
                            <input class="form-control" type="password" id="purgePassword" name="password" placeholder="Current password to confirm" autocomplete="current-password" required>
                        </div>
                        <div class="l-sign-btn">
                            <button type="submit" class="btn btn-danger btn-wmid" data-purge-submit><i class="fa-solid fa-trash fa-fw me-2" aria-hidden="true"></i>Delete all my files</button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
