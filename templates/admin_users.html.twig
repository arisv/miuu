{% extends 'admin_layout.html.twig' %}

{% block title %}
    Userlist - MIU
{% endblock %}

{% block managecontent %}
<div class="admin-list-head d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0"><i class="fa-solid fa-users me-2" aria-hidden="true"></i>Users <span class="admin-chip ms-2">{{ userlist|length }}</span></h4>
    <a href="{{ path('admin_create_user') }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create user</a>
</div>
<ul class="admin-list admin-list-users">
{% for user in userlist %}
    {% set anonymous = user.id == 0 %}
    <li class="admin-row" data-userid="{{ user.id }}">
        <div class="admin-avatar{% if anonymous %} is-anon{% endif %}" aria-hidden="true">
            {% if anonymous %}<i class="fa-solid fa-user-secret"></i>{% else %}{{ user.login|first }}{% endif %}
        </div>
        <div class="admin-identity">
            <div class="admin-title"><span data-user-login>{{ user.login }}</span> <span class="admin-chip admin-id">#{{ user.id }}</span></div>
            <div class="admin-sub">{% if anonymous %}Uploads without an account{% else %}{{ user.email }}{% endif %}</div>
        </div>
        <div class="admin-meta">
            <div class="admin-stat" data-stat="storage">
                <span class="admin-stat-label">Storage</span>
                <span class="admin-stat-value" data-usersize>Calculating&hellip;</span>
            </div>
            {% if not anonymous %}
            <div class="admin-stat" data-stat="role">
                <span class="admin-stat-label">Role</span>
                {% set isAdmin = user.role == constant('App\\Entity\\User::ROLE_ADMIN') %}
                <span class="admin-stat-value"><span class="admin-chip role-{{ isAdmin ? 'admin' : 'user' }}">{{ isAdmin ? 'Admin' : 'User' }}</span></span>
            </div>
            {% set purge = purgeStates[user.id]|default(null) %}
            <div class="admin-stat" data-stat="purge">
                <span class="admin-stat-label">Files</span>
                <span class="admin-stat-value" data-purge-state>
                    {% if purge is null %}
                        <span class="text-secondary">none</span>
                    {% elseif purge.pending %}
                        <span class="badge bg-danger">Purge at {{ purge.purge_at|date('H:i') }}</span>
                    {% else %}
                        {{ purge.total }} {{ purge.total == 1 ? 'file' : 'files' }}
                    {% endif %}
                </span>
            </div>
            <div class="admin-stat" data-stat="status">
                <span class="admin-stat-label">Status</span>
                <span class="admin-stat-value" data-userstatus>
                    {% if user.active %}
                        <span class="badge bg-success">Active</span>
                    {% else %}
                        <span class="badge bg-secondary">Disabled</span>
                    {% endif %}
                </span>
            </div>
            {% endif %}
        </div>
        {% if user.id and user.id != app.user.id %}
        {% set isAdmin = user.role == constant('App\\Entity\\User::ROLE_ADMIN') %}
        <div class="admin-actions">
            <div class="btn-group btn-group-sm" role="group" aria-label="User actions">
                <button type="button" class="btn {{ user.active ? 'btn-warning' : 'btn-success' }}"
                        data-toggle-user="{{ user.id }}" data-active="{{ user.active ? 1 : 0 }}">
                    <i class="fa-solid {{ user.active ? 'fa-ban' : 'fa-check' }} me-1" aria-hidden="true"></i>{{ user.active ? 'Disable' : 'Enable' }}
                </button>
                <button type="button" class="btn btn-secondary" data-toggle-role="{{ user.id }}" data-role="{{ user.role }}" title="{{ isAdmin ? 'Demote to user' : 'Promote to admin' }}">
                    <i class="fa-solid {{ isAdmin ? 'fa-user' : 'fa-user-shield' }} me-1" aria-hidden="true"></i>{{ isAdmin ? 'Demote' : 'Promote' }}
                </button>
                <button type="button" class="btn btn-secondary" data-reset-password="{{ user.id }}" title="Reset password">
                    <i class="fa-solid fa-key me-1" aria-hidden="true"></i>Reset
                </button>
                {% set purge = purgeStates[user.id]|default(null) %}
                {% if purge and purge.can_cancel %}
                    <button type="button" class="btn btn-warning" data-cancel-purge="{{ user.id }}" data-login="{{ user.login }}" title="Restore every file of this user">
                        <i class="fa-solid fa-trash-arrow-up me-1" aria-hidden="true"></i>Cancel purge
                    </button>
                {% else %}
                    <button type="button" class="btn btn-danger" data-purge-user="{{ user.id }}" data-login="{{ user.login }}" data-active="{{ purge ? purge.total : 0 }}" title="Schedule the deletion of every file of this user"{% if not purge or purge.total == 0 %} disabled{% endif %}>
                        <i class="fa-solid fa-broom me-1" aria-hidden="true"></i>Purge
                    </button>
                {% endif %}
                <button type="button" class="btn btn-danger" data-delete-user="{{ user.id }}" data-login="{{ user.login }}" title="Delete user">
                    <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete
                </button>
            </div>
            <div data-password-result class="small admin-password-result" hidden></div>
        </div>
        {% endif %}
    </li>
{% endfor %}
</ul>

<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteUserTitle">Delete user <span data-delete-login-title></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteUserForm" autocomplete="off">
                <div class="modal-body">
                    <p>This removes the account permanently. Their uploads stay on the server as anonymous files unless you also mark them for deletion below.</p>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="deleteUserFiles" name="mark_files" value="1">
                        <label class="form-check-label" for="deleteUserFiles">Also mark their <span data-delete-file-count></span> files for deletion</label>
                    </div>
                    <label class="form-label" for="deleteUserConfirm">Type <strong data-delete-login></strong> to continue</label>
                    <input class="form-control" id="deleteUserConfirm" name="confirm" type="text" autocomplete="off" spellcheck="false">
                    <div class="small text-danger mt-2" data-delete-error hidden></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" data-delete-submit disabled><i class="fa-solid fa-trash me-2" aria-hidden="true"></i>Delete user</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="purgeUserModal" tabindex="-1" aria-labelledby="purgeUserTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="purgeUserTitle">Purge files of <span data-purge-login-title></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="purgeUserForm" autocomplete="off">
                <div class="modal-body">
                    <p>Schedules the deletion of all <strong data-purge-file-count></strong> files of this user. Their links stop working immediately and they cannot upload; the purge command removes the files for good after the grace period. Until then the purge can be cancelled from this list.</p>
                    <label class="form-label" for="purgeUserConfirm">Type <strong data-purge-login></strong> to continue</label>
                    <input class="form-control" id="purgeUserConfirm" name="confirm" type="text" autocomplete="off" spellcheck="false">
                    <div class="small text-danger mt-2" data-purge-error hidden></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" data-purge-submit disabled><i class="fa-solid fa-broom me-2" aria-hidden="true"></i>Purge files</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
