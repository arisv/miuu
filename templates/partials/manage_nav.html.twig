{# Account navigation. Desktop: left column inside the manage layout. Phones: fixed bottom tab bar (see .profile-sidebar in app.css). #}
{% set currentRoute = app.request.get('_route') %}
<div class="list-group">
	<a href="{{path("cabinet_home")}}" class="list-group-item list-group-item-action {{ currentRoute == "cabinet_home" ? 'active' : '' }}"><i class="fa-solid fa-user fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">Profile</span><span class="nav-label-short">Profile</span></a>
	<a href="{{path("cabinet_mypics")}}" class="list-group-item list-group-item-action {{ currentRoute == "cabinet_mypics" ? 'active' : '' }}"><i class="fa-solid fa-images fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">My Pictures</span><span class="nav-label-short">Pictures</span></a>
	<a href="{{path("cabinet_token")}}" class="list-group-item list-group-item-action {{ currentRoute == "cabinet_token" ? 'active' : '' }}"><i class="fa-solid fa-key fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">Security</span><span class="nav-label-short">Security</span></a>
	{% if is_granted('ROLE_ADMIN') %}
	<a href="{{path("admin_manage_users")}}" class="list-group-item list-group-item-action {{ currentRoute == "admin_manage_users" ? 'active' : '' }}"><i class="fa-solid fa-users fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">Manage Users</span><span class="nav-label-short">Users</span></a>
	<a href="{{path("admin_create_user")}}" class="list-group-item list-group-item-action d-none d-md-block {{ currentRoute == "admin_create_user" ? 'active' : '' }}"><i class="fa-solid fa-user-plus fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">Create User</span><span class="nav-label-short">New user</span></a>
	<a href="{{path("admin_manage_files")}}" class="list-group-item list-group-item-action {{ currentRoute == "admin_manage_files" ? 'active' : '' }}"><i class="fa-solid fa-folder-open fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">Manage Files</span><span class="nav-label-short">Files</span></a>
	<a href="{{path("admin_manage_anonymous")}}" class="list-group-item list-group-item-action {{ currentRoute == "admin_manage_anonymous" ? 'active' : '' }}"><i class="fa-solid fa-user-secret fa-fw me-2" aria-hidden="true"></i><span class="nav-label-full">Anonymous Uploads</span><span class="nav-label-short">Anonymous</span></a>
		{% endif %}
</div>
