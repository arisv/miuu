{# Paginated file gallery with calendar sidebar and ordering controls.
   Expects: pageData, dateTree, nextPageRoute (route name for the "Get more" endpoint), emptyMessage.
   Items in pageData.files may be upload records (exposing .image) or bare stored files. #}
{% set months = {
    "1": "January",
    "2": "February",
    "3": "March",
    "4": "April",
    "5": "May",
    "6": "June",
    "7": "July",
    "8": "August",
    "9": "September",
    "10": "October",
    "11": "November",
    "12": "December",
} %}
{# The range the filter actually applied, already validated and sorted by CursorService;
   parsing the query string here would blow up on a malformed date. Set above the markup
   because the calendar bar in the months panel renders before the toolbar does. #}
{% set calendarRange = calendarRange|default(null) %}
{% set hasRange = calendarRange is not empty %}
{% set rangeFrom = hasRange ? calendarRange[0] : null %}
{% set rangeTo = hasRange ? calendarRange[1] : null %}
	<div class="row gallery-row">
		<div class="col-md-2 p-0 calendar-column" id="calendarPanel">
			{% if dateTree is not empty %}
				<div class="calendar-drawer-head d-flex d-md-none align-items-center justify-content-between">
					<span class="fw-semibold"><i class="fa-regular fa-calendar me-2" aria-hidden="true"></i>Filters</span>
					<button type="button" class="btn btn-secondary btn-sm" id="calendarCloseBtn" aria-label="Close calendar"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
				</div>
				<div id="calendarToolbarSlot">
					<div class="calendar-range-bar d-flex align-items-center gap-2">
						<button type="button" class="btn btn-secondary btn-sm{% if hasRange %} is-active{% endif %}" data-bs-toggle="modal" data-bs-target="#calendarRangeModal" title="Pick a date range" aria-label="Pick a date range"><i class="fa-regular fa-calendar" aria-hidden="true"></i></button>
						{% if hasRange %}
							<span class="calendar-range-label text-truncate">{% if rangeFrom|date('Y-m') == rangeTo|date('Y-m') %}{{ rangeFrom|date('M Y') }}{% elseif rangeFrom|date('Y') == rangeTo|date('Y') %}{{ rangeFrom|date('M') }} – {{ rangeTo|date('M Y') }}{% else %}{{ rangeFrom|date('M Y') }} – {{ rangeTo|date('M Y') }}{% endif %}</span>
							<button type="button" class="btn btn-secondary btn-sm ms-auto" data-clear-range title="Clear date filter" aria-label="Clear date filter"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
						{% else %}
							<span class="calendar-range-label text-secondary">All dates</span>
						{% endif %}
					</div>
				</div>
				<ul class="list-group list-group-flush">
					{% for year, monthdata in dateTree %}
						<li class="list-group-item border-miu bg-miu p-0">
							<div class="p-2">
								<h4>{{ year }}</h4>
							</div>
							<ul class="list-group list-group-flush">
								{% for month, count in monthdata %}
									<li class="list-group-item border-miu hover-miu bg-secondary-miu calendar-element" data-date="{{ year }}-{{ '%02d'|format(month) }}-01">
										<div class="d-flex align-items-center">
											<div class="w-100">
												{{ months[month] }}
												<div class="small calendar-hint" hidden>Now click the end month</div>
											</div>
											<div class="ms-auto">
												<a href="" class="btn btn-sm btn-secondary disabled">{{ count }}</a>
											</div>
										</div>
									</li>
								{% endfor %}
							</ul>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</div>
		<div class="d-md-none" id="calendarBackdrop" aria-hidden="true"></div>
		{% if dateTree is not empty %}
			<button type="button" class="btn btn-primary d-md-none" id="calendarShowBtn" aria-label="Open calendar" aria-controls="calendarPanel" aria-expanded="false"><i class="fa-regular fa-calendar" aria-hidden="true"></i></button>
		{% endif %}
		<div class="col-md-10 gallery-files">
			{% set ordering = ordering|default({'sort': 'date', 'order': 'desc', 'group': 'none'}) %}
			{% set sortLabels = {'date': 'Date', 'size': 'Size', 'type': 'Type', 'name': 'Name'} %}
			{% set groupLabels = {'none': 'None', 'date': 'Date', 'az': 'A – Z', 'type': 'Type', 'size': 'Sizes'} %}
			{% set q = app.request.query.get('q')|default('')|trim %}
			{# One list of choices, rendered twice: as dropdowns in the desktop button group and inside the phone menu. #}
			{% macro choices(field, options, current) %}
				{% for value, label in options %}
					<li><button type="button" class="dropdown-item{% if value == current %} active{% endif %}" data-order-field="{{ field }}" data-order-value="{{ value }}"><i class="fa-solid fa-check me-2" aria-hidden="true"></i>{{ label }}</button></li>
				{% endfor %}
			{% endmacro %}
			{# Sort direction rides inside the sort menu as a segmented pair rather than its own dropdown. #}
			{% macro direction(current) %}
				<li class="order-direction">
					<div class="btn-group btn-group-sm w-100" role="group" aria-label="Sort direction">
						<button type="button" class="btn btn-secondary{% if current == 'asc' %} active{% endif %}" data-order-field="order" data-order-value="asc" aria-pressed="{{ current == 'asc' ? 'true' : 'false' }}"><i class="fa-solid fa-arrow-up-short-wide me-2" aria-hidden="true"></i>Asc</button>
						<button type="button" class="btn btn-secondary{% if current == 'desc' %} active{% endif %}" data-order-field="order" data-order-value="desc" aria-pressed="{{ current == 'desc' ? 'true' : 'false' }}"><i class="fa-solid fa-arrow-down-short-wide me-2" aria-hidden="true"></i>Desc</button>
					</div>
				</li>
			{% endmacro %}
			{% import _self as toolbar %}
			<div id="navpanel" class="gallery-toolbar d-flex align-items-center gap-2{% if q is not empty %} is-searching{% endif %}">
				<div class="gallery-title me-auto">
					<div class="gallery-title-main">Library</div>
					{% set shown = totalCount|default(pageData.files|length) %}
					<div class="gallery-title-sub">{{ shown }} {% if q is not empty %}{{ shown == 1 ? 'result' : 'results' }}{% else %}{{ shown == 1 ? 'item' : 'items' }}{% endif %}</div>
				</div>
				{# Search: takes the title's slot while open; Enter applies (reloads with ?q=), Escape or × clears. #}
				<div class="input-group gallery-search me-auto" role="search">
					<input type="search" class="form-control" id="gallerySearchInput" value="{{ q }}" placeholder="Search files" aria-label="Search files" autocomplete="off" spellcheck="false" enterkeyhint="search">
					<button type="button" class="btn btn-secondary" id="gallerySearchClear" title="Clear search" aria-label="Clear search"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
				</div>
				{# Desktop: the controls as a button group. Narrow windows collapse them into the menu button. #}
				<div class="btn-group gallery-controls d-none d-xxl-inline-flex" role="group" aria-label="Sorting and filters">
					<div class="btn-group" role="group">
						<button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid {{ ordering.order == 'desc' ? 'fa-arrow-down-short-wide' : 'fa-arrow-up-short-wide' }} me-2" aria-hidden="true"></i>{{ sortLabels[ordering.sort] }}<i class="fa-solid fa-chevron-down toggle-chevron" aria-hidden="true"></i></button>
						<ul class="dropdown-menu">{{ toolbar.choices('sort', sortLabels, ordering.sort) }}<li><hr class="dropdown-divider"></li>{{ toolbar.direction(ordering.order) }}</ul>
					</div>
					<div class="btn-group" role="group">
						<button type="button" class="btn btn-secondary dropdown-toggle{% if ordering.group != 'none' %} is-active{% endif %}" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-layer-group me-2" aria-hidden="true"></i>{{ groupLabels[ordering.group] }}<i class="fa-solid fa-chevron-down toggle-chevron" aria-hidden="true"></i></button>
						<ul class="dropdown-menu">{{ toolbar.choices('group', groupLabels, ordering.group) }}</ul>
					</div>
					{% if dateTree is not empty %}
						<button type="button" class="btn btn-secondary" data-toggle-months title="Show or hide the months panel"><i class="fa-solid fa-chart-simple me-2" aria-hidden="true"></i>Months</button>
					{% endif %}
				</div>
				<button type="button" class="btn btn-secondary" id="galleryRefreshBtn" title="Reset filters" aria-label="Reset filters"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
				<button type="button" class="btn btn-secondary{% if q is not empty %} is-active{% endif %}" id="gallerySearchBtn" title="Search" aria-label="Search" aria-pressed="{{ q is not empty ? 'true' : 'false' }}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
				{# Phones and narrow windows: everything in one menu behind the "three shrinking lines" button. #}
				<div class="dropdown d-xxl-none">
					<button type="button" class="btn btn-secondary{% if ordering.group != 'none' or hasRange %} is-active{% endif %}" id="galleryMenuBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Sort, group and filter">
						<svg class="icon-lines-decrease" width="18" height="16" viewBox="0 0 18 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M1 3h16M4 8h10M7 13h4"/></svg>
					</button>
					<ul class="dropdown-menu dropdown-menu-end gallery-menu">
						<li><h6 class="dropdown-header">Sort by</h6></li>
						{{ toolbar.choices('sort', sortLabels, ordering.sort) }}
						{{ toolbar.direction(ordering.order) }}
						<li><hr class="dropdown-divider"></li>
						<li><h6 class="dropdown-header">Group by</h6></li>
						{{ toolbar.choices('group', groupLabels, ordering.group) }}
						<li><hr class="dropdown-divider"></li>
						{% if dateTree is not empty %}
							<li><button type="button" class="dropdown-item" data-open-months><i class="fa-solid fa-chart-simple me-2" aria-hidden="true"></i>Months</button></li>
						{% endif %}
						{% if hasRange %}
							<li><button type="button" class="dropdown-item" data-clear-range><i class="fa-solid fa-xmark me-2" aria-hidden="true"></i>Clear date filter</button></li>
						{% endif %}
					</ul>
				</div>
				<button type="button" class="btn btn-secondary" id="gallerySelectBtn" aria-pressed="false">Select</button>
			</div>
			{# Date range picker, opened from the bar above the months panel. #}
			<div class="modal fade" id="calendarRangeModal" tabindex="-1" aria-labelledby="calendarRangeTitle" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered modal-sm">
					<div class="modal-content glass-modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="calendarRangeTitle">Date range</h5>
							<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body d-grid gap-3">
							<label class="d-grid gap-1">From<input type="date" class="form-control" id="calendarRangeStart" value="{{ hasRange ? rangeFrom|date('Y-m-d') : '' }}"></label>
							<label class="d-grid gap-1">To<input type="date" class="form-control" id="calendarRangeEnd" value="{{ hasRange ? rangeTo|date('Y-m-t') : '' }}"></label>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary me-auto" data-clear-range{% if not hasRange %} disabled{% endif %}>Clear</button>
							<button type="button" class="btn btn-primary" id="calendarRangeApply">Apply</button>
						</div>
					</div>
				</div>
			</div>
			{% if purge is defined and purge.pending %}
				<div class="alert alert-danger m-3 purge-notice">
					<i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
					All your files are queued for deletion at <strong>{{ purge.purge_at|date('H:i, j F') }}</strong>. Until then they are hidden and uploads are paused.
					<a href="{{ path('cabinet_home') }}" class="alert-link">Cancel the deletion on your profile page.</a>
				</div>
			{% elseif pageData.files is not empty %}
				<div class="row g-0" id="file-container">
					{% set previousGroup = null %}
					{% for item in pageData.files %}
						{% set file = item.image is defined ? item.image : item %}
						{% set label = file_group_label(file, ordering.group) %}
						{% if label is not null and label != previousGroup %}
							<div class="gallery-group-header" data-group="{{ label }}">{{ label }}</div>
							{% set previousGroup = label %}
						{% endif %}
						{% include 'partials/control_panel_file.html.twig' with {'item': file, 'group': ordering.group} %}
					{% endfor %}
				</div>
				<div id="selectionBar" role="toolbar" aria-label="Selected files">
					<span class="selection-count"></span>
					<div class="btn-group btn-group-sm">
						<button type="button" class="btn btn-secondary" data-selection-action="preview" title="Preview"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
						<button type="button" class="btn btn-primary" data-selection-action="download" title="Download"><i class="fa-solid fa-download" aria-hidden="true"></i></button>
						<button type="button" class="btn btn-danger" data-selection-action="del" title="Delete"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
						<button type="button" class="btn btn-warning" data-selection-action="undo" title="Undelete"><i class="fa-solid fa-trash-arrow-up" aria-hidden="true"></i></button>
						<button type="button" class="btn btn-secondary" data-selection-action="clear" title="Clear selection"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
						<button type="button" class="btn btn-secondary" data-selection-action="done" title="Done selecting">Done</button>
					</div>
				</div>
				<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewTitle" aria-hidden="true">
					<div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-md-down preview-dialog">
						<div class="modal-content preview-content">
							<div class="modal-header">
								<h5 class="modal-title text-truncate" id="previewTitle"></h5>
								<span class="preview-counter ms-3 text-nowrap"></span>
								<button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="preview-nav-strip d-md-none" role="group" aria-label="Previous and next file">
								<button type="button" class="btn btn-secondary" data-preview-nav="-1" aria-label="Previous file"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
								<button type="button" class="btn btn-secondary" data-preview-nav="1" aria-label="Next file"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
							</div>
							<div class="modal-body preview-body"></div>
							<div class="modal-footer">
								<span class="preview-meta me-auto"></span>
								<div class="btn-group d-none d-md-inline-flex" role="group" aria-label="Previous and next file">
									<button type="button" class="btn btn-secondary" data-preview-nav="-1" title="Previous (←)"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
									<button type="button" class="btn btn-secondary" data-preview-nav="1" title="Next (→)"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
								</div>
								<a href="#" class="btn btn-secondary" data-preview-open title="Open the file page"><i class="fa-solid fa-arrow-up-right-from-square me-2" aria-hidden="true"></i><span class="btn-label">Open</span></a>
								<button type="button" class="btn btn-primary clipbutton" data-preview-copy title="Copy link"><i class="fa-solid fa-link me-2" aria-hidden="true"></i><span class="clip-label btn-label">Copy link</span></button>
								<a href="#" class="btn btn-primary" data-preview-download title="Download"><i class="fa-solid fa-download me-2" aria-hidden="true"></i><span class="btn-label">Download</span></a>
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Close"><i class="fa-solid fa-xmark me-2" aria-hidden="true"></i><span class="btn-label">Close</span></button>
							</div>
						</div>
					</div>
				</div>
				<div id="fetch-in-progress" style="display:none">
					<div class="d-flex justify-content-center my-2">
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>
				</div>
				<div class="p-3 gallery-pager" data-lg-proxy=".btn">
					{% set defaultParams = app.request.attributes.get('_route_params') | merge(app.request.query.all) %}
					{% if pageData.hasNextPage %}
						<button data-pagination-next="{{ path(nextPageRoute, defaultParams | merge({'cursor': pageData.cursor})) }}" type="button" class="btn btn-info btn-lg w-100">Get more!</button>
					{% else %}
						<button disabled type="button" class="btn btn-info btn-lg w-100">No more files!</button>
					{% endif %}
				</div>
			{% else %}
				<p class="p-3 text-secondary">{{ emptyMessage }}</p>
			{% endif %}
		</div>
	</div>
