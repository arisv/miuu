{# Paginated file gallery with calendar sidebar and ordering controls.
   Expects: pageData, dateTree, nextPageRoute (route name for the "Get more" endpoint), emptyMessage.
   Items in pageData.files may be upload records (exposing .image) or bare stored files. #}
{% set months = {
    "1": "January",
    "2": "February",
    "3": "March",
    "4": "April",
    "5": "May",
    "6": "June",
    "7": "July",
    "8": "August",
    "9": "September",
    "10": "October",
    "11": "November",
    "12": "December",
} %}
	<div class="row" style="height: 1440px">
		<div class="col-md-2 border-right-miu p-0 overflow-auto h-100">
			{% if dateTree is not empty %}
				<ul class="list-group list-group-flush">
					{% for year, monthdata in dateTree %}
						<li class="list-group-item border-miu bg-miu p-0">
							<div class="p-2">
								<h4>{{ year }}</h4>
							</div>
							<ul class="list-group list-group-flush">
								{% for month, count in monthdata %}
									<li class="list-group-item border-miu hover-miu bg-secondary-miu calendar-element" data-date="{{ year ~ '-' ~ month ~ '-01' }}">
										<div class="d-flex align-items-center">
											<div class="w-100">{{ months[month] }}</div>
											<div class="ms-auto">
												<a href="" class="btn btn-sm btn-secondary disabled">{{ count }}</a>
											</div>
										</div>
									</li>
								{% endfor %}
							</ul>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</div>
		<div class="col-md-10  overflow-auto h-100">
			{% if pageData.files is not empty %}
				<div id="navpanel" class="d-flex justify-content-end">
					<form id="order-form" class="d-flex align-items-center gap-2 m-2" action="">
						<label class="mb-0 text-nowrap" for="order-size">File size:</label>
						<select name="order-size" class="form-select w-auto" id="order-size">
							<option hidden value="">Default</option>
							<option value="big">Big</option>
							<option value="small">Small</option>
						</select>
						<label class="mb-0 text-nowrap" for="order-date">Upload date:</label>
						<select name="order-date" class="form-select w-auto" id="order-date">
							<option hidden value="">Default</option>
							<option value="new">Newest</option>
							<option value="old">Oldest</option>
						</select>
						<input type="hidden" name="calendar-start">
						<input type="hidden" name="calendar-end">
						<button type="submit" class="btn btn-primary text-nowrap">Order</button>
					</form>
				</div>
				<div class="row g-0" id="file-container">
					{% for item in pageData.files %}
						{% include 'partials/control_panel_file.html.twig' with {'item': item.image is defined ? item.image : item} %}
					{% endfor %}
				</div>
				<div id="fetch-in-progress" style="display:none">
					<div class="d-flex justify-content-center my-2">
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<div class="spinner-grow" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
					</div>
				</div>
				<div class="row">
					{% set defaultParams = app.request.attributes.get('_route_params') | merge(app.request.query.all) %}
					{% if pageData.hasNextPage %}
						<button data-pagination-next="{{ path(nextPageRoute, defaultParams | merge({'cursor': pageData.cursor})) }}" type="button" class="btn btn-info btn-lg w-100 m-3">Get more!</button>
					{% else %}
						<button disabled type="button" class="btn btn-info btn-lg w-100 m-3">No more files!</button>
					{% endif %}
				</div>
			{% else %}
				{{ emptyMessage }}
			{% endif %}
		</div>
	</div>
