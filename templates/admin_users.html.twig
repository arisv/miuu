{% extends 'admin_layout.html.twig' %}

{% block title %}
    Userlist - MIU
{% endblock %}

{% block managecontent %}
<table class="table-responsive-sm table table-dark table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Storage usage</th>
            <th>Status</th>
            <th>Role</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for user in userlist %}
        <tr data-userid="{{ user.id }}">
            <td>{{ user.id }}</td>
            <td>{{ user.login }}</td>
            <td>{{ user.email }}</td>
            <td data-usersize>Calculating...</td>
            <td data-userstatus>
                {% if user.active %}
                    <span class="badge badge-success">Active</span>
                {% else %}
                    <span class="badge badge-secondary">Disabled</span>
                {% endif %}
            </td>
            <td>{{ user.role }}</td>
            <td>
                {% if user.id and user.id != app.user.id %}
                    <button type="button" class="btn btn-sm {{ user.active ? 'btn-outline-warning' : 'btn-outline-success' }}"
                            data-toggle-user="{{ user.id }}" data-active="{{ user.active ? 1 : 0 }}">
                        {{ user.active ? 'Disable' : 'Enable' }}
                    </button>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}