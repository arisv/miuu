{% extends 'admin_layout.html.twig' %}

{% block title %}
    Userlist - MIU
{% endblock %}

{% block managecontent %}
<div class="admin-list-head d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0"><i class="fa-solid fa-users me-2" aria-hidden="true"></i>Users <span class="admin-chip ms-2">{{ userlist|length }}</span></h4>
    <a href="{{ path('admin_create_user') }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Create user</a>
</div>
<ul class="admin-list admin-list-users">
{% for user in userlist %}
    {% set anonymous = user.id == 0 %}
    <li class="admin-row" data-userid="{{ user.id }}">
        <div class="admin-avatar{% if anonymous %} is-anon{% endif %}" aria-hidden="true">
            {% if anonymous %}<i class="fa-solid fa-user-secret"></i>{% else %}{{ user.login|first }}{% endif %}
        </div>
        <div class="admin-identity">
            <div class="admin-title"><span data-user-login>{{ user.login }}</span> <span class="admin-chip admin-id">#{{ user.id }}</span></div>
            <div class="admin-sub">{% if anonymous %}Uploads without an account{% else %}{{ user.email }}{% endif %}</div>
        </div>
        <div class="admin-meta">
            <div class="admin-stat" data-stat="storage">
                <span class="admin-stat-label">Storage</span>
                <span class="admin-stat-value" data-usersize>Calculating&hellip;</span>
            </div>
            {% if not anonymous %}
            <div class="admin-stat" data-stat="role">
                <span class="admin-stat-label">Role</span>
                {% set isAdmin = user.role == constant('App\\Entity\\User::ROLE_ADMIN') %}
                <span class="admin-stat-value"><span class="admin-chip role-{{ isAdmin ? 'admin' : 'user' }}">{{ isAdmin ? 'Admin' : 'User' }}</span></span>
            </div>
            <div class="admin-stat" data-stat="status">
                <span class="admin-stat-label">Status</span>
                <span class="admin-stat-value" data-userstatus>
                    {% if user.active %}
                        <span class="badge bg-success">Active</span>
                    {% else %}
                        <span class="badge bg-secondary">Disabled</span>
                    {% endif %}
                </span>
            </div>
            {% endif %}
        </div>
        {% if user.id and user.id != app.user.id %}
        <div class="admin-actions">
            <div class="btn-group btn-group-sm" role="group" aria-label="User actions">
                <button type="button" class="btn {{ user.active ? 'btn-warning' : 'btn-success' }}"
                        data-toggle-user="{{ user.id }}" data-active="{{ user.active ? 1 : 0 }}">
                    <i class="fa-solid {{ user.active ? 'fa-ban' : 'fa-check' }} me-1" aria-hidden="true"></i>{{ user.active ? 'Disable' : 'Enable' }}
                </button>
                <button type="button" class="btn btn-danger" data-reset-password="{{ user.id }}">
                    <i class="fa-solid fa-key me-1" aria-hidden="true"></i>Reset password
                </button>
            </div>
            <div data-password-result class="small admin-password-result" hidden></div>
        </div>
        {% endif %}
    </li>
{% endfor %}
</ul>
{% endblock %}
