{% extends 'base_layout.html.twig' %}

{% block title %}
    {{ file.originalName }} - MIU
{% endblock %}

{% block meta %}
{% if not file.markedForDeletion %}
{% set fileUrl = url('get_file_custom_url', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) %}
{% set viewUrl = url('view_file', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) %}
{% set thumbUrl = file.isThumbnailable ? url('serve_file_thumbnail', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) : null %}
{% set shownExt = '.' in file.originalName ? file.originalName|split('.')|last : extension %}
{% set description = (shownExt|upper) ~ ' · ' ~ size ~ ' · ' ~ file.getDate|date("Y-m-d H:i") ~ ' UTC' %}
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#34e6a1">
    <meta property="og:site_name" content="MIU">
    <meta property="og:title" content="{{ file.originalName }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ viewUrl }}">
    {% if kind == 'image' %}
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ fileUrl }}">
    <meta property="og:image:type" content="{{ file.internalMimetype }}">
    {% if imageSize %}
    <meta property="og:image:width" content="{{ imageSize.width }}">
    <meta property="og:image:height" content="{{ imageSize.height }}">
    {% endif %}
    <meta property="og:image:alt" content="{{ file.originalName }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{ fileUrl }}">
    {% elseif kind == 'video' %}
    <meta property="og:type" content="video.other">
    <meta property="og:video" content="{{ fileUrl }}">
    <meta property="og:video:url" content="{{ fileUrl }}">
    <meta property="og:video:secure_url" content="{{ fileUrl }}">
    <meta property="og:video:type" content="{{ file.internalMimetype }}">
    {% if thumbUrl %}
    <meta property="og:image" content="{{ thumbUrl }}">
    <meta name="twitter:image" content="{{ thumbUrl }}">
    {% endif %}
    <meta name="twitter:card" content="player">
    <meta name="twitter:player" content="{{ viewUrl }}">
    <meta name="twitter:player:stream" content="{{ fileUrl }}">
    <meta name="twitter:player:stream:content_type" content="{{ file.internalMimetype }}">
    {% elseif kind == 'audio' %}
    <meta property="og:type" content="music.song">
    <meta property="og:audio" content="{{ fileUrl }}">
    <meta property="og:audio:secure_url" content="{{ fileUrl }}">
    <meta property="og:audio:type" content="{{ file.internalMimetype }}">
    <meta property="og:image" content="{{ absolute_url(asset('static/logo.png')) }}">
    <meta name="twitter:card" content="summary">
    {% else %}
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ absolute_url(asset('static/logo.png')) }}">
    <meta name="twitter:card" content="summary">
    {% endif %}
    <meta name="twitter:title" content="{{ file.originalName }}">
    <meta name="twitter:description" content="{{ description }}">
    <link rel="canonical" href="{{ viewUrl }}">
{% else %}
    <meta name="robots" content="noindex">
{% endif %}
{% endblock %}

{% block maincontent %}
{% set fileUrl = url('get_file_custom_url', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) %}
{% set hidden = file.markedForDeletion %}
<div class="block-app container view-sheet{% if hidden %} is-marked{% endif %}" data-fileid="{{ file.id }}">
    <div class="view-stage view-stage-{{ kind }}">
        {% if hidden %}
            <div class="view-ext view-ext-hidden" aria-hidden="true"><i class="fa-solid fa-trash"></i></div>
            <p class="view-note">This file is marked for deletion and is no longer served.</p>
        {% elseif kind == 'image' %}
            <a href="{{ fileUrl }}"><img class="view-media" src="{{ fileUrl }}" alt="{{ file.originalName }}"></a>
        {% elseif kind == 'video' %}
            {% set poster = file.isThumbnailable ? path('serve_file_thumbnail', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) : '' %}
            <div class="view-player" data-media-player="video" data-src="{{ fileUrl }}" data-poster="{{ poster }}">
                <video class="view-media" controls playsinline preload="metadata" src="{{ fileUrl }}"{% if poster %} poster="{{ poster }}"{% endif %}></video>
            </div>
        {% elseif kind == 'audio' %}
            <div class="view-player" data-media-player="audio" data-src="{{ fileUrl }}">
                <audio class="view-audio" controls preload="metadata" src="{{ fileUrl }}"></audio>
            </div>
        {% elseif kind == 'text' and text is not null %}
            <pre class="view-text" tabindex="0">{{ text }}</pre>
            {% if textTruncated %}<p class="view-note mb-2">Showing the first 512 KB. Download the file for the rest.</p>{% endif %}
        {% else %}
            <div class="view-ext" aria-hidden="true"><i class="fa-solid {{ file_icon(file.internalMimetype, file.originalExtension, file.originalName) }}"></i><span class="view-ext-label">{{ ('.' in file.originalName ? file.originalName|split('.')|last : extension)|slice(0, 7) }}</span></div>
        {% endif %}
    </div>
    <div class="view-caption">
        <h1 class="view-title">{{ file.originalName }}</h1>
        <div class="view-meta">
            <span class="admin-chip">{{ ('.' in file.originalName ? file.originalName|split('.')|last : extension)|upper }}</span>
            <span>{{ size }}</span>
            <span>{{ file.getDate|date("Y-m-d H:i") }}</span>
            <span class="admin-chip admin-marked" data-marked-chip {% if not hidden %}hidden{% endif %}><i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Marked for deletion</span>
        </div>
    </div>
    <div class="view-actions">
        <div class="btn-group" role="group" aria-label="File actions">
            <a href="{{ fileUrl }}" class="btn btn-primary" download><i class="fa-solid fa-download me-2" aria-hidden="true"></i>Download</a>
            <button type="button" class="btn btn-secondary clipbutton" data-clipboard-text="{{ kind in ['image', 'video', 'audio'] ? fileUrl : url('view_file', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) }}"><i class="fa-solid fa-link me-2" aria-hidden="true"></i>Copy link</button>
            {% if canManage %}
                <button type="button" class="btn {{ hidden ? 'btn-warning' : 'btn-danger' }}" data-view-delete="{{ file.id }}" data-action="{{ hidden ? 'undo' : 'del' }}">
                    <i class="fa-solid {{ hidden ? 'fa-trash-arrow-up' : 'fa-trash' }} me-2" aria-hidden="true"></i><span>{{ hidden ? 'Undelete' : 'Delete' }}</span>
                </button>
            {% endif %}
        </div>
        <div class="small view-result" data-view-result hidden></div>
    </div>
</div>
{% endblock %}
