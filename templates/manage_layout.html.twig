{% extends 'base_layout.html.twig' %}
{% set currentRoute = app.request.get('_route') %}
{% block title %}
	{{ app.user.login }}'s files - MIU
{% endblock %}

{% block maincontent %}
	<div class="block-app container-fluid">
		<div class="row">
			<div class="col-md-2 profile-sidebar">
				{% include 'partials/manage_nav.html.twig' %}
			</div>
				<div class="col manage-content">
			{% block managecontent %}
					<div id="profile">
						<h3>Welcome, {{ app.user.login }}</h3>
						<p>
							Current API token: <strong>{{ app.user.remotetoken }}</strong>
						</p>
					</div>
				{% endblock %}
				</div>
		</div>
	</div>
{% endblock %}
