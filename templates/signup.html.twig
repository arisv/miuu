{% extends 'base_layout.html.twig' %}

{% form_theme form 'form/miu_errors.html.twig' %}

{% block title %}
  MIU
{% endblock %}

{% block maincontent %}
  <div class="row">
    <div class="col-md-2 mx-auto pt-4">
      {{ form_start(form) }}

      <h1 class="text-center mrgb30">Sign up
      </h1>

      {% include 'partials/user_form_fields.html.twig' %}

      <div class="l-sign-inner">
        {{ form_errors(form) }}
        <div class="l-sign-btn l-sign-btn-center">
          <button id="login-form-button" type="submit" class="btn btn-primary btn-wmid"><i class="fa-solid fa-user-plus fa-fw me-2" aria-hidden="true"></i>Register</button>
        </div>
      </div>
      <!-- /.l-sign-inner -->

      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}
