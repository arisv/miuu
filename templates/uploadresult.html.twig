{% extends 'base_layout.html.twig' %}

{% block title %}
    Uploaded - MIU
{% endblock %}

{% block maincontent %}
    <div id="uploader">
        <div class="row justify-content-center">
            <div class="col-md-6 col-12">
                <div class="d-flex align-items-center gap-2 my-4">
                    <input class="form-control" id="uploadResult" readonly title="Here's your file!" value="{{ url('get_file_custom_url', {'customUrl': file.customUrl, 'fileExtension': file.originalExtension}) }}">
                    <button id="clipboardbtn" type="button" class="btn btn-success clipbutton" data-clipboard-target="#uploadResult" title="Copy to clipboard">
                        <img src="{{ asset('static/clippy.svg') }}" alt="Copy to clipboard" width="15">
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
