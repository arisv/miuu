{% extends 'base_layout.html.twig' %}

{% block title %}
MIU
{% endblock %}

{% block stylesheets %}
{{ parent() }}
{{ encore_entry_link_tags('home') }}
{% endblock %}

{% block maincontent %}
{% set can_upload = is_granted('ROLE_USER') or allow_anonymous_uploads %}
{% if not can_upload %}
<div id="uploader" class="block-app container">
    <div class="row sideblock justify-content-md-center" id="upload-box">
        <div class="col-md-8 col-sm-12 upload-box-empty" id="upload-box-inner" aria-hidden="true"></div>
    </div>
    <div class="row sideblock justify-content-md-center" id="mirror-box">
        <div class="col-md-6 col-sm-12 py-4 uploads-disabled">
            <h2 class="h4 mb-2">Anonymous uploads are disabled</h2>
            <p class="mb-3">Log in to upload files{% if allow_registration %}, or create an account{% endif %}.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a href="{{ path('auth_login') }}" class="btn btn-primary"><i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Login</a>
                {% if allow_registration %}
                <a href="{{ path('auth_register') }}" class="btn btn-secondary"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>Sign up</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% else %}
<div id="uploader" class="block-app container">
    <div class="row sideblock justify-content-md-center" id="upload-box">
        <div class="col-md-8 col-sm-12" id="upload-box-inner">
            <div id="upload-legacy">
                <h2>Upload your file (100Mb max)</h2>
                <form class="d-flex align-items-center gap-2" action="/getfile/" method="post" enctype="multipart/form-data">
                    <label class="btn btn-default btn-file">
                        Browse <input type="file" name="meowfile">
                    </label>
                    <input type="submit" value="Upload" class="btn btn-primary">
                </form>
            </div>
            <div class="upload-dropzone">
                <div class="dropzone-border">
                    <div class="dropzone" id="dropzonefield"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row sideblock justify-content-md-center" id="mirror-box">
        <div class="col-md-6 col-sm-12">
            <p class="mt-2 mb-0">Upload a file</p>
            <p class="mb-0 mt-0"><span></span>or<span></span></p>
            <form id="mirror_uploader" class="mirror-form" action="/mirrorfile/" method="post"
                enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="mirrorfile">Mirror a file</label>
                    <input id="mirrorfile" name="mirrorfile" placeholder="Direct link" class="form-control" type="text" value="">
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-outline-primary btn-outline-miu">Fetch</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('home') }}
<script>

</script>
{% endblock %}