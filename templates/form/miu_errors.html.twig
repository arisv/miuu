{# Form theme rendering field errors as a Bootstrap alert list. Shared by signup and admin user creation. #}
{% block form_errors %}

  {% if errors is defined and errors|length > 0 %}
    <div class="alert alert-danger">
      <ul class="list-unstyled">
        {% for error in errors %}
          <li>{{ error.message }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

{% endblock form_errors %}
